{
  // Статический сайт на Cloudflare Workers (static assets). Сборка: npm run build → dist/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ladrimiau",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "ladrimiau.com", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": false
}
