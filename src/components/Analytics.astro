---
// Google Tag Manager with Consent Mode v2. Visitors in European time zones get no Google script until
// they accept. Elsewhere analytics runs without advertising storage, and Google still
// applies the denied default to EEA, UK and Swiss traffic by IP.
import { GTM_ID } from '../data/site.js';

const EEA = ['AT', 'BE', 'BG', 'HR', 'CY', 'CZ', 'DK', 'EE', 'FI', 'FR', 'DE', 'GR', 'HU', 'IS', 'IE', 'IT', 'LV', 'LI', 'LT', 'LU', 'MT', 'NL', 'NO', 'PL', 'PT', 'RO', 'SK', 'SI', 'ES', 'SE', 'GB', 'CH'];
---
{GTM_ID && (
  <>
    <div class="consent" id="consent" role="region" aria-label="Preferencias de cookies" hidden>
      <p>Usamos cookies de análisis para saber qué páginas son útiles y mejorar el sitio. <a href="/privacidad/">Política de privacidad y cookies</a></p>
      <div class="consent-actions">
        <button type="button" data-consent="no">Rechazar</button>
        <button type="button" data-consent="yes">Aceptar</button>
      </div>
    </div>
    <script is:inline define:vars={{ GTM_ID, EEA }}>
      (function () {
        var KEY = 'ld_consent';
        var box = document.getElementById('consent');
        var stored = null;
        try { stored = localStorage.getItem(KEY); } catch (error) {}
        var zone = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
        var europe = /^Europe\//.test(zone) || ['Atlantic/Canary', 'Atlantic/Madeira', 'Atlantic/Azores', 'Atlantic/Reykjavik', 'Africa/Ceuta'].indexOf(zone) !== -1;
        var loaded = false;

        function gtag() { window.dataLayer.push(arguments); }

        function load(granted) {
          if (loaded) return;
          loaded = true;
          window.dataLayer = window.dataLayer || [];
          var denied = { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' };
          gtag('consent', 'default', Object.assign({ analytics_storage: 'denied', region: EEA, wait_for_update: 500 }, denied));
          gtag('consent', 'default', Object.assign({ analytics_storage: 'granted' }, denied));
          if (granted !== null) gtag('consent', 'update', { analytics_storage: granted ? 'granted' : 'denied' });
          window.dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });
          var script = document.createElement('script');
          script.async = true;
          script.src = 'https://www.googletagmanager.com/gtm.js?id=' + GTM_ID;
          document.head.appendChild(script);
        }

        // Load Google's scripts after the page has rendered so they never delay it.
        function whenIdle(task) {
          var run = function () { if ('requestIdleCallback' in window) requestIdleCallback(task, { timeout: 3000 }); else setTimeout(task, 1500); };
          if (document.readyState === 'complete') run(); else window.addEventListener('load', run, { once: true });
        }
        if (stored === 'yes') whenIdle(function () { load(true); });
        else if (stored !== 'no' && !europe) whenIdle(function () { load(null); });
        if (!stored && europe) box.hidden = false;

        box.addEventListener('click', function (event) {
          var choice = event.target.getAttribute && event.target.getAttribute('data-consent');
          if (!choice) return;
          try { localStorage.setItem(KEY, choice); } catch (error) {}
          if (choice === 'yes') {
            load(true);
            gtag('consent', 'update', { analytics_storage: 'granted' });
          } else if (loaded) {
            gtag('consent', 'update', { analytics_storage: 'denied' });
          }
          box.hidden = true;
        });

        document.querySelectorAll('[data-open-consent]').forEach(function (button) {
          button.addEventListener('click', function () { box.hidden = false; });
        });
      })();
    </script>
  </>
)}

<style is:global>
  .consent { position: fixed; inset-inline: 0.75rem; bottom: 0.75rem; z-index: 20; display: flex; flex-wrap: wrap; gap: 0.6rem 1rem; align-items: center; max-width: 46rem; margin-inline: auto; padding: 0.85rem 1rem; border-radius: 16px; background: var(--ink); color: #fff; font-size: 0.925rem; line-height: 1.4; box-shadow: 0 10px 30px rgb(42 31 61 / 35%); }
  .consent[hidden] { display: none; }
  .consent p { flex: 1 1 16rem; margin: 0; }
  .consent a { color: #fff; }
  .consent-actions { display: grid; flex: 1 1 13rem; grid-template-columns: 1fr 1fr; gap: 0.5rem; }
  .consent-actions button { min-height: 2.75rem; border: 2px solid #fff; border-radius: 12px; background: #fff; color: var(--ink); box-shadow: none; }
  .consent-actions button:hover { background: #efe9f8; }
  .footer-button { width: auto; min-height: 2.5rem; padding: 0; border-radius: 0; background: none; color: #fff; font-weight: 700; text-decoration: underline; box-shadow: none; }
  .footer-button:hover { background: none; }
</style>
