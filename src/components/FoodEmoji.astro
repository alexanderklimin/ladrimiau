---
// Colour food artwork from Twemoji (CC BY 4.0), served locally so it renders on every device.
interface Props { emoji: string; class?: string; eager?: boolean }
const { emoji, class: className = 'food-emoji', eager = false } = Astro.props;
const file = [...emoji].map((char) => char.codePointAt(0)!.toString(16)).filter((code) => code !== 'fe0f').join('-');
---
<img class={className} src={`/food/${file}.svg`} alt="" width="32" height="32" loading={eager ? 'eager' : 'lazy'} decoding="async" />
